---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  lift?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes = '(min-width: 90rem) 900px, (min-width: 64rem) 62vw, (min-width: 48rem) 75vw, 100vw',
  eager = false,
  lift = true,
  class: cls,
} = Astro.props;
---

<figure class:list={['plate neu', { 'plate--lift': lift }, cls]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[480, 800, 1200, 1800]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
  />
</figure>

<style>
  .plate {
    padding: clamp(4px, 3.63px + 0.095vw, 5px);
    border-radius: clamp(18px, 16.5px + 0.38vw, 22px);
  }
  .plate :global(img) {
    width: 100%;
    border-radius: clamp(14px, 12.5px + 0.38vw, 17px);
  }
  .plate--lift {
    transition:
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.6s ease;
  }
  @media (hover: hover) {
    .plate--lift:hover {
      transform: translateY(-10px);
      box-shadow:
        calc(40px * var(--s)) calc(40px * var(--s)) calc(90px * var(--s)) var(--lo),
        calc(-40px * var(--s)) calc(-40px * var(--s)) calc(90px * var(--s)) var(--hi);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate--lift {
      transition: none;
    }
    .plate--lift:hover {
      transform: none;
    }
  }
</style>
