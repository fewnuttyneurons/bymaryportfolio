---
import { t, EMAIL, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const tr = t(Astro.props.lang);
---

<section id="contact" class="butter" aria-labelledby="contact-title">
  <div class="wrap outer">
    <div class="card neu-lg">
      <h2 id="contact-title" class="head">{tr('contact.title')}</h2>
      <p>{tr('contact.body')}</p>
      <div class="socket neu-in pill">
        <a href={`mailto:${EMAIL}`} lang="en" dir="ltr" class="email rust btn pill">{EMAIL}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .outer {
    padding-block: clamp(88px, 72.4px + 4vw, 130px) clamp(64px, 46.5px + 4.48vw, 110px);
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 19.5px + 1.14vw, 36px);
    padding: clamp(52px, 35.7px + 4.19vw, 96px) clamp(20px, 7.4px + 3.24vw, 64px);
    border-radius: clamp(40px, 31px + 2.29vw, 64px);
    text-align: center;
  }
  h2 {
    max-width: 62.5rem;
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-rust);
  }
  :lang(fa) h2 {
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0;
  }
  p {
    font-size: var(--fs-lead);
    color: var(--muted);
  }
  .socket {
    max-width: 100%;
    padding: clamp(4px, 3.63px + 0.095vw, 5px);
  }
  .email {
    display: block;
    padding: clamp(20px, 16.3px + 0.95vw, 30px) clamp(18px, 7.4px + 3.81vw, 64px);
    font-family: var(--font-serif);
    /* Scales down on the narrowest phones so the address never breaks mid-word. */
    font-size: min(var(--fs-cta), 6.4vw);
    line-height: 1;
    white-space: nowrap;
    background: linear-gradient(145deg, #cc4410, #a63000);
    color: var(--color-butter);
    /* Sits on the butter card, so it casts butter-toned shadows. */
    box-shadow:
      calc(18px * var(--s)) calc(18px * var(--s)) calc(42px * var(--s)) #d2b85e,
      calc(-18px * var(--s)) calc(-18px * var(--s)) calc(42px * var(--s)) #fff7c6;
  }
</style>
