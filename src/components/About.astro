---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const tr = t(Astro.props.lang);
---

<section id="about" class="rust" aria-labelledby="about-title">
  <div class="wrap outer">
    <div class="well neu-in">
      <h2 id="about-title" class="head">{tr('about.title')}</h2>
      <blockquote>{tr('about.quote')}</blockquote>
      <p>{tr('about.body')}</p>
    </div>
  </div>
</section>

<style>
  .outer {
    padding-block: var(--band-y);
  }
  .well {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 17px + 0.76vw, 28px);
    padding: clamp(44px, 30.6px + 3.43vw, 80px) clamp(26px, -5.2px + 8vw, 110px);
    border-radius: clamp(36px, 28.6px + 1.9vw, 56px);
  }
  h2 {
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  :lang(fa) h2 {
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0;
  }
  blockquote {
    max-width: 62.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-quote);
    line-height: 1.25;
  }
  :lang(fa) blockquote {
    font-family: var(--font-fa);
    font-style: normal;
    font-weight: 500;
    line-height: 1.8;
  }
  p {
    max-width: 43.75rem;
    margin-top: 4px;
    font-size: var(--fs-lead);
    color: var(--muted);
  }
</style>
