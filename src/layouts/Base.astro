---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import ogSource from '../assets/work/sente/packaging-line.webp';
import { dir, homePath, t, EMAIL, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const site = Astro.site!;
const canonical = new URL(homePath(lang), site);
const og = await getImage({ src: ogSource, width: 1200, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Maryam Malmir',
  alternateName: 'By Mary',
  jobTitle: 'Graphic designer',
  email: `mailto:${EMAIL}`,
  url: site.href,
};
---

<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tr('meta.title')}</title>
    <meta name="description" content={tr('meta.description')} />
    <meta name="theme-color" content="#BA3801" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', site)} />
    <link rel="alternate" hreflang="fa" href={new URL('/fa/', site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="By Mary" />
    <meta property="og:title" content={tr('meta.title')} />
    <meta property="og:description" content={tr('meta.description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? 849)} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
  </body>
</html>
